{
    "manifest_version": 3,
    "name": "MyDM — Chrome Bridge",
    "version": "0.2.0",
    "description": "Gửi link HTTP/HTTPS đến MyDM trên Windows. Hỗ trợ tải bằng phiên đăng nhập.",
    "permissions": [
        "nativeMessaging",
        "downloads",
        "contextMenus",
        "storage"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "optional_permissions": [
        "cookies"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "32": "icons/icon32.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "32": "icons/icon32.png",
        "128": "icons/icon128.png"
    }
}
