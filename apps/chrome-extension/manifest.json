{
    "manifest_version": 3,
    "name": "MyDM Integration Module",
    "version": "0.3.0",
    "description": "Tích hợp tải xuống thông minh và bắt video từ mọi trang web cho MyDM trên Windows.",
    "permissions": [
        "nativeMessaging",
        "downloads",
        "contextMenus",
        "storage",
        "cookies",
        "webRequest"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "yt_injected.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*",
                "yt_injected.js"
            ],
            "matches": [
                "http://*/*",
                "https://*/*"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "32": "icons/icon32.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "32": "icons/icon32.png",
        "128": "icons/icon128.png"
    }
}
